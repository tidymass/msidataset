{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation summary TSV decoded as records",
  "description": "Read UTF-8 cells as strings. Required properties are also the ordered TSV header. validation_id is a unique key over the table.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "validation_id",
      "section",
      "dataset",
      "stage",
      "purpose",
      "metric",
      "value",
      "reference_value",
      "pass_criterion",
      "status",
      "independent",
      "source_file",
      "source_sha256",
      "commit",
      "recompute",
      "caveat"
    ],
    "properties": {
      "validation_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.]+$"
      },
      "section": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "外部验证",
          "内部复现",
          "其他数据集",
          "R 包复现"
        ]
      },
      "dataset": {
        "type": "string",
        "minLength": 1
      },
      "stage": {
        "type": "string",
        "minLength": 1
      },
      "purpose": {
        "type": "string",
        "minLength": 1
      },
      "metric": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "type": "string",
        "minLength": 1,
        "description": "Literal value or slash-delimited components in metric order. A compact n/d is a numerator/denominator."
      },
      "reference_value": {
        "type": "string",
        "description": "Saved baseline or historical report comparator. Empty when unavailable."
      },
      "pass_criterion": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "PASS",
          "PARTIAL",
          "FAIL",
          "仅描述"
        ]
      },
      "independent": {
        "type": "string",
        "minLength": 1
      },
      "source_file": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(WEEK|PKG|DATA)/[^;\\t\\r\\n]+(; (WEEK|PKG|DATA)/[^;\\t\\r\\n]+)*$",
        "description": "Ordered archive paths. Roots and report directories are configured separately."
      },
      "source_sha256": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}(; [a-f0-9]{64})*$",
        "description": "SHA-256 values positionally aligned with source_file."
      },
      "commit": {
        "type": "string",
        "minLength": 1,
        "pattern": "^([a-f0-9]{7,40}|未核实)$"
      },
      "recompute": {
        "type": "string",
        "minLength": 1,
        "description": "Operation applied this run, including direct reads of saved evaluation statistics."
      },
      "caveat": {
        "type": "string"
      }
    }
  }
}
